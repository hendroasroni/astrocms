---
import BaseLayout from "@layouts/BaseLayout.astro";
import ArticleCard from "@components/ArticleCard.astro";
import { getPosts } from "@core/content/posts";
import type { Post } from "@core/api/types";

let posts: Post[] = [];
try {
  const allPosts = await getPosts();
  posts = allPosts.filter((p) => p.status === "published");
} catch (e) {
  console.log("Fallback blog list");
}
---

<BaseLayout
  title="Artikel & Resep Kuliner"
  description="Kumpulan berita, tips, dan informasi menarik seputar pempek dan kuliner Palembang."
>
  <div class="container blog-header">
    <span class="blog-tag">Pusat Informasi</span>
    <h1 class="blog-title">Artikel & Berita Terbaru</h1>
    <p class="blog-desc">Temukan berbagai cerita menarik, tips mengolah pempek, dan info promo terkini.</p>
  </div>

  <div class="container blog-container">
    <div class="blog-grid" id="blog-posts-grid" style={posts.length === 0 ? "display: none;" : ""}>
      {posts.map((post) => (
        <ArticleCard post={post} />
      ))}
    </div>
    <div class="empty-state" id="blog-empty-state" style={posts.length > 0 ? "display: none;" : ""}>
      <p>Belum ada artikel yang dipublikasikan saat ini. Silakan kunjungi kembali nanti!</p>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      try {
        const localData = localStorage.getItem("astrocms_posts") || localStorage.getItem("astro_cms_mock_posts");
        if (localData) {
          const posts = JSON.parse(localData);
          const published = (Array.isArray(posts) ? posts : []).filter((p: any) => p && p.status === "published");
          const grid = document.getElementById("blog-posts-grid");
          const empty = document.getElementById("blog-empty-state");

          if (grid && published.length > 0) {
            grid.style.display = "grid";
            if (empty) empty.style.display = "none";
            grid.innerHTML = published.map((post: any) => `
              <article class="article-card">
                ${post.image ? `
                  <a href="/blog/${post.slug}" class="card-media">
                    <img src="${post.image}" alt="${post.title}" loading="lazy" />
                  </a>
                ` : ""}
                <div class="card-body">
                  ${post.category ? `<span class="card-category">${post.category}</span>` : ""}
                  <h3 class="card-title">
                    <a href="/blog/${post.slug}">${post.title}</a>
                  </h3>
                  <p class="card-excerpt">${post.excerpt || ""}</p>
                  <div class="card-meta">
                    <time>${post.published_at ? new Date(post.published_at).toLocaleDateString("id-ID", { year: "numeric", month: "short", day: "numeric" }) : ""}</time>
                  </div>
                </div>
              </article>
            `).join("");
          }
        }
      } catch (e) {
        console.warn("Blog preview sync:", e);
      }
    });
  </script>
</BaseLayout>

<style>
  .blog-header {
    text-align: center;
    padding: 4rem 1rem 3rem;
  }

  .blog-tag {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .blog-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-text);
    margin-top: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .blog-desc {
    color: var(--color-text-muted);
    max-width: 600px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  .blog-container {
    padding-bottom: 5rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
