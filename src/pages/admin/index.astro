---
import AdminLayout from "@layouts/AdminLayout.astro";
---

<AdminLayout title="Dashboard" activeMenu="dashboard">
  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-info">
      <h2>Ringkasan Dashboard</h2>
      <p>Pantau statistik artikel, katalog produk, dan status performa website Anda.</p>
    </div>
    <div style="display: flex; gap: 0.75rem;">
      <a href="/admin/posts" class="btn btn-primary btn-sm">+ Tulis Artikel Baru</a>
      <button id="btn-quick-rebuild" class="btn btn-outline btn-sm">
        🚀 Trigger Deploy Hook
      </button>
    </div>
  </div>

  <!-- Symmetrical 4-Card Stats Grid -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon" style="background-color: #eff6ff; color: #2563eb;">📝</div>
      <div class="stat-info">
        <h3 id="stat-posts">0</h3>
        <p>Total Artikel</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background-color: #fef3c7; color: #d97706;">📄</div>
      <div class="stat-info">
        <h3 id="stat-drafts">0</h3>
        <p>Draft Artikel</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background-color: #dcfce7; color: #16a34a;">🛍️</div>
      <div class="stat-info">
        <h3 id="stat-products">0</h3>
        <p>Total Produk</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon" style="background-color: #f3e8ff; color: #9333ea;">⚡</div>
      <div class="stat-info">
        <h3>SSG</h3>
        <p>Astro Engine</p>
      </div>
    </div>
  </div>

  <!-- Recent Articles Table -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3 class="admin-card-title">Artikel Terbaru</h3>
      <a href="/admin/posts" style="font-size: 0.825rem; font-weight: 600; color: var(--admin-primary); text-decoration: none;">
        Lihat Semua &rarr;
      </a>
    </div>

    <div class="table-container">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Judul Artikel</th>
            <th>Kategori</th>
            <th>Status</th>
            <th>Tanggal Publikasi</th>
          </tr>
        </thead>
        <tbody id="posts-table-body">
          <tr>
            <td colspan="4" style="text-align: center; color: var(--admin-text-muted); padding: 2.5rem;">
              Memuat data artikel...
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    import { getPosts } from "@core/content/posts";
    import { getProducts } from "@core/content/products";
    import { getSettings, triggerDeployHook } from "@core/settings/site";
    import { formatDate } from "@core/utils/date";

    async function loadDashboard() {
      try {
        const [posts, products] = await Promise.all([getPosts(), getProducts()]);
        const statPosts = document.getElementById("stat-posts");
        const statDrafts = document.getElementById("stat-drafts");
        const statProducts = document.getElementById("stat-products");
        const tableBody = document.getElementById("posts-table-body");

        const drafts = posts.filter((p) => p.status === "draft");

        if (statPosts) statPosts.textContent = posts.length.toString();
        if (statDrafts) statDrafts.textContent = drafts.length.toString();
        if (statProducts) statProducts.textContent = products.length.toString();

        if (tableBody) {
          if (posts.length === 0) {
            tableBody.innerHTML = `
              <tr>
                <td colspan="4" style="text-align: center; color: var(--admin-text-muted); padding: 3rem;">
                  <div style="font-size: 2rem; margin-bottom: 0.5rem;">📝</div>
                  <p style="font-weight: 600;">Belum ada artikel</p>
                  <p style="font-size: 0.8rem; margin-top: 0.25rem;">Klik tombol "Tulis Artikel Baru" di atas untuk membuat artikel pertama.</p>
                </td>
              </tr>
            `;
          } else {
            tableBody.innerHTML = posts.slice(0, 5).map((post) => `
              <tr>
                <td>
                  <div style="font-weight: 600; color: var(--admin-text-main);">${post.title}</div>
                  <div style="font-size: 0.75rem; color: var(--admin-text-muted);">/blog/${post.slug}</div>
                </td>
                <td><span class="category-tag">${post.category || "Umum"}</span></td>
                <td>
                  <span class="status-pill ${post.status === 'published' ? 'published' : 'draft'}">
                    ${post.status === 'published' ? '● Published' : '○ Draft'}
                  </span>
                </td>
                <td style="color: var(--admin-text-muted); font-size: 0.85rem;">
                  ${formatDate(post.published_at || post.updated_at)}
                </td>
              </tr>
            `).join("");
          }
        }
      } catch (e) {
        console.error("Dashboard error:", e);
      }
    }

    const btnDeploy = document.getElementById("btn-quick-rebuild");
    if (btnDeploy) {
      btnDeploy.addEventListener("click", async () => {
        if (!confirm("Kirim sinyal Deploy Webhook ke platform hosting untuk rebuild website?")) return;
        btnDeploy.textContent = "Mengirim...";
        try {
          const settings = await getSettings();
          if (!settings.deploy_hook_url) {
            (window as any).showToast("Deploy Hook URL belum diisi di Pengaturan Situs!", "error");
            btnDeploy.textContent = "🚀 Trigger Deploy Hook";
            return;
          }
          const ok = await triggerDeployHook(settings.deploy_hook_url);
          if (ok) {
            (window as any).showToast("Deploy Webhook berhasil dikirim! Website sedang di-rebuild.", "success");
          } else {
            (window as any).showToast("Gagal memanggil Deploy Webhook.", "error");
          }
        } catch {
          (window as any).showToast("Terjadi kesalahan saat memanggil Deploy Webhook.", "error");
        } finally {
          btnDeploy.textContent = "🚀 Trigger Deploy Hook";
        }
      });
    }

    loadDashboard();
  </script>
</AdminLayout>
