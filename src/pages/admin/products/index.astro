---
import AdminLayout from "@layouts/AdminLayout.astro";
---

<AdminLayout title="Kelola Produk & Menu" activeMenu="products">
  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-info">
      <h2>Katalog Produk & Menu</h2>
      <p>Kelola menu kuliner, paket hemat, penetapan harga normal/diskon, dan foto produk.</p>
    </div>
    <button id="btn-open-modal" class="btn btn-primary btn-sm">+ Tambah Produk Baru</button>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="toolbar-card">
    <div class="search-input-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="search-products" class="search-input" placeholder="Cari nama produk..." />
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <select id="filter-status" class="filter-select">
        <option value="all">Semua Status</option>
        <option value="published">Published</option>
        <option value="draft">Draft</option>
      </select>
    </div>
  </div>

  <!-- Products Table -->
  <div class="table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Produk</th>
          <th>Kategori</th>
          <th>Harga</th>
          <th>Status</th>
          <th style="text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody id="products-list">
        <tr>
          <td colspan="5" style="text-align: center; color: var(--admin-text-muted); padding: 2.5rem;">
            Memuat katalog produk...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Modal Form Create / Edit Product (2-Column Split) -->
  <div id="product-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card" style="max-width: 820px;">
      <div class="modal-header">
        <h3 id="modal-title">Tambah Produk Baru</h3>
        <button id="btn-close-modal" style="background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: var(--admin-text-muted); line-height: 1;">&times;</button>
      </div>

      <form id="product-form" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
        <input type="hidden" id="prod-id" />

        <div class="modal-body">
          <div class="split-form-grid">
            <!-- Left Column: Product Details -->
            <div>
              <div class="form-group">
                <label class="form-label" for="prod-name">Nama Produk / Layanan *</label>
                <input class="form-input" type="text" id="prod-name" required placeholder="Contoh: Paket Pempek Kapal Selam" />
              </div>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="form-group">
                  <label class="form-label" for="prod-price">Harga Normal (Rp) *</label>
                  <input class="form-input" type="number" id="prod-price" required placeholder="85000" />
                </div>
                <div class="form-group">
                  <label class="form-label" for="prod-discount">Harga Diskon (Rp)</label>
                  <input class="form-input" type="number" id="prod-discount" placeholder="Opsional (misal: 75000)" />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="prod-desc">Deskripsi Produk</label>
                <textarea class="form-textarea" id="prod-desc" rows="4" placeholder="Jelaskan isi paket atau keunggulan menu..."></textarea>
              </div>
            </div>

            <!-- Right Column: Product Image & Status -->
            <div>
              <div class="form-group">
                <label class="form-label" for="prod-status">Status Publikasi</label>
                <select class="form-select" id="prod-status">
                  <option value="published">Published (Tampil)</option>
                  <option value="draft">Draft (Sembunyikan)</option>
                </select>
              </div>

              <div class="form-group">
                <label class="form-label" for="prod-category">Kategori Menu</label>
                <input class="form-input" type="text" id="prod-category" placeholder="Paket Hemat / Satuan" />
              </div>

              <!-- Product Image Upload -->
              <div class="form-group">
                <label class="form-label">Foto Produk</label>
                <input type="hidden" id="prod-image" />
                <input type="file" id="prod-image-file" accept="image/*" style="display: none;" />

                <div id="dropzone" class="image-dropzone">
                  <div id="dropzone-empty" style="display: flex; flex-direction: column; align-items: center; gap: 0.35rem;">
                    <span style="font-size: 1.75rem;">🛍️</span>
                    <p style="font-size: 0.825rem; font-weight: 600; color: var(--admin-text-main);">
                      Seret foto ke sini atau <span style="color: var(--admin-primary); text-decoration: underline; cursor: pointer;" id="btn-browse-file">Pilih File</span>
                    </p>
                    <p style="font-size: 0.725rem; color: var(--admin-text-muted);">JPG, PNG, WebP</p>
                  </div>

                  <div id="dropzone-preview" style="display: none; align-items: center; gap: 1rem; width: 100%;">
                    <img id="preview-img" src="" alt="Preview" style="width: 80px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border);" />
                    <div style="flex: 1; text-align: left;">
                      <p id="preview-filename" style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-main); word-break: break-all;"></p>
                      <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
                        <button type="button" id="btn-change-img" style="color: var(--admin-primary); font-size: 0.75rem; font-weight: 600; cursor: pointer; background: none; border: none; padding: 0;">Ganti</button>
                        <button type="button" id="btn-remove-img" style="color: var(--admin-danger); font-size: 0.75rem; font-weight: 600; cursor: pointer; background: none; border: none; padding: 0;">Hapus</button>
                      </div>
                    </div>
                  </div>

                  <div id="upload-spinner" style="display: none; font-size: 0.8rem; color: var(--admin-primary); font-weight: 600;">
                    ⏳ Mengunggah foto...
                  </div>
                </div>

                <div style="margin-top: 0.35rem; text-align: right;">
                  <button type="button" id="btn-toggle-url" style="background: none; border: none; color: var(--admin-text-muted); font-size: 0.725rem; cursor: pointer; text-decoration: underline;">
                    atau masukkan link URL
                  </button>
                </div>
                <div id="url-manual-wrap" style="display: none; margin-top: 0.35rem;">
                  <input class="form-input" type="url" id="prod-image-manual" placeholder="https://..." style="font-size: 0.8rem;" />
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="btn-cancel-modal" class="btn btn-outline btn-sm">Batal</button>
          <button type="submit" id="btn-save-prod" class="btn btn-primary btn-sm">Simpan Produk</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { getProducts, createProduct, updateProduct, deleteProduct } from "@core/content/products";
    import { slugify } from "@core/utils/slug";
    import { uploadImage } from "@core/utils/uploader";
    import type { Product } from "@core/api/types";

    let allProducts: Product[] = [];

    const productsList = document.getElementById("products-list");
    const searchInput = document.getElementById("search-products") as HTMLInputElement;
    const filterStatus = document.getElementById("filter-status") as HTMLSelectElement;

    const modal = document.getElementById("product-modal");
    const modalTitle = document.getElementById("modal-title");
    const btnOpenModal = document.getElementById("btn-open-modal");
    const btnCloseModal = document.getElementById("btn-close-modal");
    const btnCancelModal = document.getElementById("btn-cancel-modal");
    const prodForm = document.getElementById("product-form") as HTMLFormElement;
    const btnSaveProd = document.getElementById("btn-save-prod") as HTMLButtonElement;

    const prodIdInput = document.getElementById("prod-id") as HTMLInputElement;
    const prodNameInput = document.getElementById("prod-name") as HTMLInputElement;
    const prodCategoryInput = document.getElementById("prod-category") as HTMLInputElement;
    const prodStatusSelect = document.getElementById("prod-status") as HTMLSelectElement;
    const prodPriceInput = document.getElementById("prod-price") as HTMLInputElement;
    const prodDiscountInput = document.getElementById("prod-discount") as HTMLInputElement;
    const prodImageInput = document.getElementById("prod-image") as HTMLInputElement;
    const prodDescInput = document.getElementById("prod-desc") as HTMLTextAreaElement;

    // Image Upload Elements
    const dropzone = document.getElementById("dropzone") as HTMLDivElement;
    const fileInput = document.getElementById("prod-image-file") as HTMLInputElement;
    const btnBrowse = document.getElementById("btn-browse-file");
    const dropzoneEmpty = document.getElementById("dropzone-empty") as HTMLDivElement;
    const dropzonePreview = document.getElementById("dropzone-preview") as HTMLDivElement;
    const previewImg = document.getElementById("preview-img") as HTMLImageElement;
    const previewFilename = document.getElementById("preview-filename") as HTMLParagraphElement;
    const uploadSpinner = document.getElementById("upload-spinner") as HTMLDivElement;
    const btnChangeImg = document.getElementById("btn-change-img");
    const btnRemoveImg = document.getElementById("btn-remove-img");
    const btnToggleUrl = document.getElementById("btn-toggle-url");
    const urlManualWrap = document.getElementById("url-manual-wrap") as HTMLDivElement;
    const prodImageManual = document.getElementById("prod-image-manual") as HTMLInputElement;

    function formatRupiah(num: number) {
      return new Intl.NumberFormat("id-ID", { style: "currency", currency: "IDR", maximumFractionDigits: 0 }).format(num || 0);
    }

    function setPreview(url: string, name: string = "Foto Produk") {
      prodImageInput.value = url;
      prodImageManual.value = url;
      if (url) {
        previewImg.src = url;
        previewFilename.textContent = name;
        dropzoneEmpty.style.display = "none";
        dropzonePreview.style.display = "flex";
      } else {
        previewImg.src = "";
        dropzoneEmpty.style.display = "flex";
        dropzonePreview.style.display = "none";
      }
    }

    async function handleFileUpload(file: File) {
      if (!file || !file.type.startsWith("image/")) {
        (window as any).showToast("Pilih file gambar valid (JPG, PNG, WebP).", "error");
        return;
      }
      dropzoneEmpty.style.display = "none";
      dropzonePreview.style.display = "none";
      uploadSpinner.style.display = "block";

      try {
        const uploadedUrl = await uploadImage(file);
        setPreview(uploadedUrl, file.name);
        (window as any).showToast("Foto produk berhasil diunggah!", "success");
      } catch (err: any) {
        (window as any).showToast("Gagal upload: " + err.message, "error");
        dropzoneEmpty.style.display = "flex";
      } finally {
        uploadSpinner.style.display = "none";
      }
    }

    if (btnBrowse) btnBrowse.addEventListener("click", () => fileInput.click());
    if (btnChangeImg) btnChangeImg.addEventListener("click", () => fileInput.click());
    if (btnRemoveImg) btnRemoveImg.addEventListener("click", () => {
      fileInput.value = "";
      setPreview("");
    });

    fileInput.addEventListener("change", () => {
      if (fileInput.files && fileInput.files[0]) handleFileUpload(fileInput.files[0]);
    });

    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });
    dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dragover"));
    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");
      if (e.dataTransfer?.files?.[0]) handleFileUpload(e.dataTransfer.files[0]);
    });

    if (btnToggleUrl) {
      btnToggleUrl.addEventListener("click", () => {
        urlManualWrap.style.display = urlManualWrap.style.display === "none" ? "block" : "none";
      });
    }

    prodImageManual.addEventListener("input", () => {
      setPreview(prodImageManual.value.trim(), "URL Luar");
    });

    function openModal(prod?: Product) {
      if (prod) {
        if (modalTitle) modalTitle.textContent = "Edit Produk";
        prodIdInput.value = prod.id;
        prodNameInput.value = prod.name;
        prodCategoryInput.value = prod.category || "";
        prodStatusSelect.value = prod.status || "published";
        prodPriceInput.value = prod.price?.toString() || "";
        prodDiscountInput.value = prod.discount_price?.toString() || "";
        prodDescInput.value = prod.description || "";
        setPreview(prod.image || "", "Foto Produk");
      } else {
        if (modalTitle) modalTitle.textContent = "Tambah Produk Baru";
        prodForm.reset();
        prodIdInput.value = "";
        setPreview("");
      }
      if (modal) modal.style.display = "flex";
    }

    function closeModal() {
      if (modal) modal.style.display = "none";
    }

    if (btnOpenModal) btnOpenModal.addEventListener("click", () => openModal());
    if (btnCloseModal) btnCloseModal.addEventListener("click", closeModal);
    if (btnCancelModal) btnCancelModal.addEventListener("click", closeModal);

    function renderFilteredProducts() {
      if (!productsList) return;
      const search = searchInput.value.toLowerCase().trim();
      const status = filterStatus.value;

      const filtered = allProducts.filter((p) => {
        const matchesSearch = p.name.toLowerCase().includes(search);
        const matchesStatus = status === "all" || p.status === status;
        return matchesSearch && matchesStatus;
      });

      if (filtered.length === 0) {
        productsList.innerHTML = `
          <tr>
            <td colspan="5" style="text-align: center; color: var(--admin-text-muted); padding: 3rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🛍️</div>
              <p style="font-weight: 600;">Tidak ada produk yang cocok.</p>
            </td>
          </tr>
        `;
        return;
      }

      productsList.innerHTML = filtered.map((p) => `
        <tr>
          <td>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              ${p.image ? `<img src="${p.image}" alt="" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border); flex-shrink: 0;" />` : `
                <div style="width: 44px; height: 44px; background: var(--admin-surface-alt); border-radius: 6px; border: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">🛍️</div>
              `}
              <div>
                <div style="font-weight: 600; color: var(--admin-text-main); font-size: 0.9rem;">${p.name}</div>
                <div style="font-size: 0.75rem; color: var(--admin-text-muted);">${p.description || "-"}</div>
              </div>
            </div>
          </td>
          <td><span class="category-tag">${p.category || "Menu"}</span></td>
          <td style="font-weight: 700; color: var(--admin-primary);">
            ${p.discount_price ? `
              <span style="color: var(--admin-success);">${formatRupiah(p.discount_price)}</span>
              <small style="text-decoration: line-through; color: var(--admin-text-light); margin-left: 4px; font-weight: 400;">${formatRupiah(p.price)}</small>
            ` : formatRupiah(p.price)}
          </td>
          <td>
            <span class="status-pill ${p.status === 'published' ? 'published' : 'draft'}">
              ${p.status === 'published' ? '● Published' : '○ Draft'}
            </span>
          </td>
          <td style="text-align: right;">
            <div class="action-buttons">
              <button class="btn-icon-action btn-edit" data-id="${p.id}">✏️ Edit</button>
              <button class="btn-icon-action delete btn-delete" data-id="${p.id}">🗑️</button>
            </div>
          </td>
        </tr>
      `).join("");

      document.querySelectorAll(".btn-edit").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = (btn as HTMLElement).dataset.id;
          const p = allProducts.find((item) => item.id === id);
          if (p) openModal(p);
        });
      });

      document.querySelectorAll(".btn-delete").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = (btn as HTMLElement).dataset.id;
          if (confirm("Apakah Anda yakin ingin menghapus produk ini?")) {
            if (id) {
              await deleteProduct(id);
              (window as any).showToast("Produk berhasil dihapus!", "success");
              loadProducts();
            }
          }
        });
      });
    }

    async function loadProducts() {
      try {
        allProducts = await getProducts();
        if (allProducts.length === 0) {
          allProducts = [
            { id: "prod-1", name: "Paket Pempek Kapal Selam", slug: "paket-pempek-kapal-selam", price: 85000, category: "Paket Hemat", status: "published", description: "3 Kapal Selam Telur Utuh + Cuko Mantap", image: "https://images.unsplash.com/photo-1541544741938-0af808871cc0?w=600&auto=format&fit=crop&q=80", updated_at: new Date().toISOString() },
            { id: "prod-2", name: "Paket Campur Komplit (20 pcs)", slug: "paket-campur-komplit", price: 120000, discount_price: 105000, category: "Paket Keluarga", status: "published", description: "Adaan, Lenjer, Kulit + 2 Botol Cuko", image: "https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=600&auto=format&fit=crop&q=80", updated_at: new Date().toISOString() },
          ];
        }
        renderFilteredProducts();
      } catch (err) {
        console.error(err);
      }
    }

    searchInput.addEventListener("input", renderFilteredProducts);
    filterStatus.addEventListener("change", renderFilteredProducts);

    prodForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      btnSaveProd.disabled = true;
      btnSaveProd.textContent = "Menyimpan...";

      const isEdit = !!prodIdInput.value;
      const prodData: Partial<Product> = {
        name: prodNameInput.value.trim(),
        slug: slugify(prodNameInput.value),
        category: prodCategoryInput.value.trim(),
        status: prodStatusSelect.value as "published" | "draft",
        price: parseFloat(prodPriceInput.value) || 0,
        discount_price: prodDiscountInput.value ? parseFloat(prodDiscountInput.value) : undefined,
        image: prodImageInput.value.trim(),
        description: prodDescInput.value.trim(),
        updated_at: new Date().toISOString(),
      };

      try {
        if (isEdit) {
          await updateProduct(prodIdInput.value, prodData);
          (window as any).showToast("Produk berhasil diperbarui!", "success");
        } else {
          await createProduct(prodData);
          (window as any).showToast("Produk baru berhasil ditambahkan!", "success");
        }
        closeModal();
        loadProducts();
      } catch (err: any) {
        (window as any).showToast("Gagal menyimpan produk: " + (err.message || "Error"), "error");
      } finally {
        btnSaveProd.disabled = false;
        btnSaveProd.textContent = "Simpan Produk";
      }
    });

    loadProducts();
  </script>
</AdminLayout>
