---
import AdminLayout from "@layouts/AdminLayout.astro";
---

<AdminLayout title="Pengaturan Situs" activeMenu="settings">
  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-info">
      <h2>Pengaturan Website</h2>
      <p>Kelola identitas situs, konfigurasi SEO, integrasi Deploy Hook, dan slot monetisasi iklan.</p>
    </div>
  </div>

  <!-- Tab Navigation -->
  <div class="settings-tabs">
    <button type="button" class="tab-btn active" data-tab="tab-general">
      <span>🏷️</span>
      <span>Informasi Umum</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-seo">
      <span>🔍</span>
      <span>SEO & Indexing</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-ads">
      <span>📢</span>
      <span>Monetisasi Iklan</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-deploy">
      <span>🚀</span>
      <span>Deploy & Hosting</span>
    </button>
    <button type="button" class="tab-btn" data-tab="tab-scripts">
      <span>📊</span>
      <span>Custom Scripts</span>
    </button>
  </div>

  <form id="settings-form">
    <!-- Tab 1: General Info -->
    <div id="tab-general" class="tab-panel active">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Identitas Website & Kontak</h3>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="site-name">Nama Website</label>
            <input class="form-input" type="text" id="site-name" placeholder="Pempek Ilen" />
          </div>
          <div class="form-group">
            <label class="form-label" for="site-tagline">Tagline / Slogan</label>
            <input class="form-input" type="text" id="site-tagline" placeholder="Gurih, Lembut, dan Asli Palembang" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="site-description">Deskripsi Singkat Situs (Meta Description)</label>
          <textarea class="form-textarea" id="site-description" rows="2" placeholder="Deskripsi ringkas profil usaha untuk mesin pencari."></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="contact-whatsapp">Nomor WhatsApp (Format: 628...)</label>
            <input class="form-input" type="text" id="contact-whatsapp" placeholder="628123456789" />
          </div>
          <div class="form-group">
            <label class="form-label" for="contact-email">Email Bisnis</label>
            <input class="form-input" type="email" id="contact-email" placeholder="kontak@pempekilen.com" />
          </div>
          <div class="form-group">
            <label class="form-label" for="social-instagram">Instagram URL</label>
            <input class="form-input" type="url" id="social-instagram" placeholder="https://instagram.com/pempekilen" />
          </div>
        </div>
      </div>
    </div>

    <!-- Tab 2: SEO & Indexing -->
    <div id="tab-seo" class="tab-panel">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Optimasi Mesin Pencari (Search Engine Optimization)</h3>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="gsc-verification">Google Search Console Verification Code</label>
            <input class="form-input" type="text" id="gsc-verification" placeholder="google-site-verification=xxxx" />
            <p class="form-hint">Kode meta verifikasi kepemilikan situs dari Google Search Console.</p>
          </div>

          <div class="form-group">
            <label class="form-label" for="indexnow-key">IndexNow API Key (Bing / Instant Index)</label>
            <input class="form-input" type="text" id="indexnow-key" placeholder="32 karakter key" />
            <p class="form-hint">Otomatis mengirim sinyal pengindeksan instan ke mesin pencari setiap kali artikel dipublikasikan.</p>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="default-og-image">Default Social Banner (OG Image URL)</label>
          <input class="form-input" type="url" id="default-og-image" placeholder="https://.../og-banner.jpg" />
          <p class="form-hint">Gambar pratinjau yang muncul saat link website dibagikan ke WhatsApp, Twitter, atau Facebook.</p>
        </div>
      </div>
    </div>

    <!-- Tab 3: Ads & Monetization -->
    <div id="tab-ads" class="tab-panel">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Manajemen Slot Iklan & Monetisasi</h3>
        </div>

        <div style="display: flex; gap: 2rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer;">
            <input type="checkbox" id="enable-ads-articles" checked />
            <span>Aktifkan Iklan di Artikel Blog</span>
          </label>
          <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; font-weight: 600; cursor: pointer;">
            <input type="checkbox" id="enable-ads-homepage" />
            <span>Aktifkan Iklan di Homepage</span>
          </label>
        </div>

        <div class="form-group">
          <label class="form-label" for="ads-paragraph-interval">Sisipkan Iklan In-Content Otomatis Setiap (N Paragraf)</label>
          <input class="form-input" type="number" id="ads-paragraph-interval" min="1" max="10" value="2" style="max-width: 140px;" />
          <p class="form-hint">Default: 2 (Iklan disisipkan otomatis setelah paragraf ke-2).</p>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="ads-header">Slot Iklan Header (Atas)</label>
            <textarea class="form-textarea" id="ads-header" rows="3" placeholder="<script ...></script> atau banner ad unit"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="ads-before-content">Slot Iklan Sebelum Konten Artikel</label>
            <textarea class="form-textarea" id="ads-before-content" rows="3" placeholder="<ins class='adsbygoogle' ...></ins>"></textarea>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;">
          <div class="form-group">
            <label class="form-label" for="ads-in-content">Slot Iklan Sela Paragraf (In-Content)</label>
            <textarea class="form-textarea" id="ads-in-content" rows="3" placeholder="<ins class='adsbygoogle' ...></ins>"></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="ads-after-content">Slot Iklan Setelah Konten Artikel</label>
            <textarea class="form-textarea" id="ads-after-content" rows="3" placeholder="<ins class='adsbygoogle' ...></ins>"></textarea>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="ads-footer">Slot Iklan Footer (Bawah)</label>
          <textarea class="form-textarea" id="ads-footer" rows="3" placeholder="Sticky banner atau responsive footer ad"></textarea>
        </div>
      </div>
    </div>

    <!-- Tab 4: Deploy & Webhook -->
    <div id="tab-deploy" class="tab-panel">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Deploy Webhook (Cloudflare Pages / Netlify / Vercel)</h3>
        </div>

        <div class="form-group">
          <label class="form-label" for="deploy-hook-url">Deploy Hook URL</label>
          <input class="form-input" type="url" id="deploy-hook-url" placeholder="https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/..." />
          <p class="form-hint">URL webhook yang dipanggil otomatis saat artikel baru di-publish untuk men-trigger build ulang SSG.</p>
        </div>
      </div>
    </div>

    <!-- Tab 5: Custom Scripts -->
    <div id="tab-scripts" class="tab-panel">
      <div class="admin-card">
        <div class="admin-card-header">
          <h3 class="admin-card-title">Custom Tracking Scripts</h3>
        </div>

        <div class="form-group">
          <label class="form-label" for="head-scripts">Custom Head Scripts (Google Analytics 4 / Google Tag Manager)</label>
          <textarea class="form-textarea" id="head-scripts" rows="3" placeholder="<script async src='https://www.googletagmanager.com/gtag/js?id=...'></script>"></textarea>
          <p class="form-hint">Disisipkan tepat sebelum tag penutup <code>&lt;/head&gt;</code>.</p>
        </div>

        <div class="form-group">
          <label class="form-label" for="body-scripts">Custom Body Scripts (Meta Pixel / Live Chat)</label>
          <textarea class="form-textarea" id="body-scripts" rows="3" placeholder="<!-- Meta Pixel Code -->"></textarea>
          <p class="form-hint">Disisipkan tepat sebelum tag penutup <code>&lt;/body&gt;</code>.</p>
        </div>
      </div>
    </div>

    <!-- Sticky Bottom Save Bar -->
    <div class="sticky-save-bar">
      <span style="font-size: 0.85rem; color: var(--admin-text-muted);">
        Pastikan perubahan Anda sudah sesuai sebelum menyimpan.
      </span>
      <button type="submit" id="btn-save-settings" class="btn btn-primary">
        💾 Simpan Semua Pengaturan
      </button>
    </div>
  </form>

  <script>
    import { getSettings, updateSettings } from "@core/settings/site";

    // Tab Switching Logic
    const tabButtons = document.querySelectorAll(".tab-btn");
    const tabPanels = document.querySelectorAll(".tab-panel");

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetTab = (btn as HTMLElement).dataset.tab;
        tabButtons.forEach((b) => b.classList.remove("active"));
        tabPanels.forEach((p) => p.classList.remove("active"));

        btn.classList.add("active");
        const panel = document.getElementById(targetTab || "");
        if (panel) panel.classList.add("active");
      });
    });

    const form = document.getElementById("settings-form") as HTMLFormElement;
    const btnSave = document.getElementById("btn-save-settings") as HTMLButtonElement;

    // Inputs
    const siteName = document.getElementById("site-name") as HTMLInputElement;
    const siteTagline = document.getElementById("site-tagline") as HTMLInputElement;
    const siteDesc = document.getElementById("site-description") as HTMLTextAreaElement;
    const contactWa = document.getElementById("contact-whatsapp") as HTMLInputElement;
    const contactEmail = document.getElementById("contact-email") as HTMLInputElement;
    const socialIg = document.getElementById("social-instagram") as HTMLInputElement;
    const gscVerif = document.getElementById("gsc-verification") as HTMLInputElement;
    const indexnowKey = document.getElementById("indexnow-key") as HTMLInputElement;
    const defaultOg = document.getElementById("default-og-image") as HTMLInputElement;
    const deployHook = document.getElementById("deploy-hook-url") as HTMLInputElement;

    const enableAdsArticles = document.getElementById("enable-ads-articles") as HTMLInputElement;
    const enableAdsHomepage = document.getElementById("enable-ads-homepage") as HTMLInputElement;
    const adsInterval = document.getElementById("ads-paragraph-interval") as HTMLInputElement;
    const adsHeader = document.getElementById("ads-header") as HTMLTextAreaElement;
    const adsBefore = document.getElementById("ads-before-content") as HTMLTextAreaElement;
    const adsIn = document.getElementById("ads-in-content") as HTMLTextAreaElement;
    const adsAfter = document.getElementById("ads-after-content") as HTMLTextAreaElement;
    const adsFooter = document.getElementById("ads-footer") as HTMLTextAreaElement;

    const headScripts = document.getElementById("head-scripts") as HTMLTextAreaElement;
    const bodyScripts = document.getElementById("body-scripts") as HTMLTextAreaElement;

    async function loadSettings() {
      try {
        const data = await getSettings();
        if (data) {
          if (data.site_name) siteName.value = data.site_name;
          if (data.site_tagline) siteTagline.value = data.site_tagline;
          if (data.site_description) siteDesc.value = data.site_description;
          if (data.whatsapp) contactWa.value = data.whatsapp;
          if (data.email) contactEmail.value = data.email;
          if (data.instagram) socialIg.value = data.instagram;
          if (data.gsc_verification) gscVerif.value = data.gsc_verification;
          if (data.indexnow_key) indexnowKey.value = data.indexnow_key;
          if (data.default_og_image) defaultOg.value = data.default_og_image;
          if (data.deploy_hook_url) deployHook.value = data.deploy_hook_url;

          enableAdsArticles.checked = data.enable_ads_articles !== false;
          enableAdsHomepage.checked = !!data.enable_ads_homepage;
          if (data.ads_paragraph_interval) adsInterval.value = data.ads_paragraph_interval.toString();
          if (data.ads_header) adsHeader.value = data.ads_header;
          if (data.ads_before_content) adsBefore.value = data.ads_before_content;
          if (data.ads_in_content) adsIn.value = data.ads_in_content;
          if (data.ads_after_content) adsAfter.value = data.ads_after_content;
          if (data.ads_footer) adsFooter.value = data.ads_footer;

          if (data.custom_head_scripts) headScripts.value = data.custom_head_scripts;
          if (data.custom_body_end_scripts) bodyScripts.value = data.custom_body_end_scripts;
        }
      } catch (err) {
        console.error("Failed to load settings:", err);
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btnSave.disabled = true;
      btnSave.textContent = "Menyimpan...";

      const payload = {
        site_name: siteName.value.trim(),
        site_tagline: siteTagline.value.trim(),
        site_description: siteDesc.value.trim(),
        whatsapp: contactWa.value.trim(),
        email: contactEmail.value.trim(),
        instagram: socialIg.value.trim(),
        gsc_verification: gscVerif.value.trim(),
        indexnow_key: indexnowKey.value.trim(),
        default_og_image: defaultOg.value.trim(),
        deploy_hook_url: deployHook.value.trim(),

        enable_ads_articles: enableAdsArticles.checked,
        enable_ads_homepage: enableAdsHomepage.checked,
        ads_paragraph_interval: parseInt(adsInterval.value) || 2,
        ads_header: adsHeader.value,
        ads_before_content: adsBefore.value,
        ads_in_content: adsIn.value,
        ads_after_content: adsAfter.value,
        ads_footer: adsFooter.value,

        custom_head_scripts: headScripts.value,
        custom_body_end_scripts: bodyScripts.value,
      };

      try {
        await updateSettings(payload);
        (window as any).showToast("Pengaturan website berhasil disimpan!", "success");
      } catch (err: any) {
        (window as any).showToast("Gagal menyimpan: " + (err.message || "Error"), "error");
      } finally {
        btnSave.disabled = false;
        btnSave.textContent = "💾 Simpan Semua Pengaturan";
      }
    });

    loadSettings();
  </script>
</AdminLayout>
