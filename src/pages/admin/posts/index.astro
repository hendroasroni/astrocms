---
import AdminLayout from "@layouts/AdminLayout.astro";
---

<AdminLayout title="Kelola Artikel" activeMenu="posts">
  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-info">
      <h2>Daftar Artikel Blog</h2>
      <p>Kelola konten, unggah featured image, konfigurasi slot iklan, dan optimasi SEO postingan.</p>
    </div>
    <button id="btn-open-modal" class="btn btn-primary btn-sm">+ Buat Artikel Baru</button>
  </div>

  <!-- Search & Filter Toolbar -->
  <div class="toolbar-card">
    <div class="search-input-wrap">
      <span class="search-icon">🔍</span>
      <input type="text" id="search-posts" class="search-input" placeholder="Cari judul artikel..." />
    </div>

    <div style="display: flex; gap: 0.75rem;">
      <select id="filter-status" class="filter-select">
        <option value="all">Semua Status</option>
        <option value="published">Published</option>
        <option value="draft">Draft</option>
      </select>

      <select id="filter-category" class="filter-select">
        <option value="all">Semua Kategori</option>
      </select>
    </div>
  </div>

  <!-- Articles Table -->
  <div class="table-container">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Artikel</th>
          <th>Kategori</th>
          <th>Status</th>
          <th>Iklan</th>
          <th>Tanggal</th>
          <th style="text-align: right;">Aksi</th>
        </tr>
      </thead>
      <tbody id="posts-list">
        <tr>
          <td colspan="6" style="text-align: center; color: var(--admin-text-muted); padding: 2.5rem;">
            Memuat daftar artikel...
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Modal Form Create / Edit Post (2-Column Split Layout) -->
  <div id="post-modal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">Buat Artikel Baru</h3>
        <button id="btn-close-modal" style="background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: var(--admin-text-muted); line-height: 1;">&times;</button>
      </div>

      <form id="post-form" style="display: flex; flex-direction: column; flex: 1; min-height: 0;">
        <input type="hidden" id="post-id" />

        <div class="modal-body">
          <div class="split-form-grid">
            <!-- Left Column: Main Content -->
            <div>
              <div class="form-group">
                <label class="form-label" for="post-title">Judul Artikel *</label>
                <input class="form-input" type="text" id="post-title" required placeholder="Contoh: Resep Pempek Kapal Selam Lembut" />
              </div>

              <div class="form-group">
                <label class="form-label" for="post-slug">Slug URL (Otomatis)</label>
                <input class="form-input" type="text" id="post-slug" required placeholder="resep-pempek-kapal-selam-lembut" />
              </div>

              <div class="form-group">
                <label class="form-label" for="post-excerpt">Ringkasan Singkat (Excerpt)</label>
                <textarea class="form-textarea" id="post-excerpt" rows="2" placeholder="Ringkasan 1-2 kalimat untuk kartu artikel & meta deskripsi SEO."></textarea>
              </div>

              <div class="form-group">
                <label class="form-label" for="post-content">Isi Konten Artikel (Markdown / Teks) *</label>
                <textarea class="form-textarea" id="post-content" rows="9" required placeholder="Tulis artikel di sini... (Ketik <!-- ad --> di mana pun Anda ingin menempatkan iklan manual)"></textarea>
                <p class="form-hint">💡 Tips: Sisipkan kode <code>&lt;!-- ad --&gt;</code> untuk mengatur posisi iklan manual di sela tulisan.</p>
              </div>
            </div>

            <!-- Right Column: Sidebar Settings -->
            <div>
              <div class="form-group">
                <label class="form-label" for="post-status">Status Publikasi</label>
                <select class="form-select" id="post-status">
                  <option value="published">Published (Tayang)</option>
                  <option value="draft">Draft (Konsep)</option>
                </select>
              </div>

              <!-- Featured Image Upload & Preview -->
              <div class="form-group">
                <label class="form-label">Featured Image (Foto Utama)</label>
                <input type="hidden" id="post-image" />
                <input type="file" id="post-image-file" accept="image/*" style="display: none;" />

                <div id="dropzone" class="image-dropzone">
                  <div id="dropzone-empty" style="display: flex; flex-direction: column; align-items: center; gap: 0.35rem;">
                    <span style="font-size: 1.75rem;">🖼️</span>
                    <p style="font-size: 0.825rem; font-weight: 600; color: var(--admin-text-main);">
                      Seret foto ke sini atau <span style="color: var(--admin-primary); text-decoration: underline; cursor: pointer;" id="btn-browse-file">Pilih File</span>
                    </p>
                    <p style="font-size: 0.725rem; color: var(--admin-text-muted);">JPG, PNG, WebP (Otomatis optimasi)</p>
                  </div>

                  <div id="dropzone-preview" style="display: none; align-items: center; gap: 1rem; width: 100%;">
                    <img id="preview-img" src="" alt="Preview" style="width: 80px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border);" />
                    <div style="flex: 1; text-align: left;">
                      <p id="preview-filename" style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-main); word-break: break-all;"></p>
                      <div style="display: flex; gap: 0.5rem; margin-top: 0.25rem;">
                        <button type="button" id="btn-change-img" style="color: var(--admin-primary); font-size: 0.75rem; font-weight: 600; cursor: pointer; background: none; border: none; padding: 0;">Ganti</button>
                        <button type="button" id="btn-remove-img" style="color: var(--admin-danger); font-size: 0.75rem; font-weight: 600; cursor: pointer; background: none; border: none; padding: 0;">Hapus</button>
                      </div>
                    </div>
                  </div>

                  <div id="upload-spinner" style="display: none; font-size: 0.8rem; color: var(--admin-primary); font-weight: 600;">
                    ⏳ Mengunggah foto...
                  </div>
                </div>

                <div style="margin-top: 0.35rem; text-align: right;">
                  <button type="button" id="btn-toggle-url" style="background: none; border: none; color: var(--admin-text-muted); font-size: 0.725rem; cursor: pointer; text-decoration: underline;">
                    atau gunakan URL luar
                  </button>
                </div>
                <div id="url-manual-wrap" style="display: none; margin-top: 0.35rem;">
                  <input class="form-input" type="url" id="post-image-manual" placeholder="https://..." style="font-size: 0.8rem;" />
                </div>
              </div>

              <div class="form-group">
                <label class="form-label" for="post-category">Kategori</label>
                <input class="form-input" type="text" id="post-category" placeholder="Kuliner / Resep / Berita" />
              </div>

              <div class="form-group">
                <label class="form-label" for="post-tags">Tags (Pisahkan koma)</label>
                <input class="form-input" type="text" id="post-tags" placeholder="pempek, cuko, palembang" />
              </div>

              <!-- Exclude Ads Box -->
              <div style="background-color: var(--admin-surface-alt); border: 1px solid var(--admin-border); border-radius: var(--admin-radius-sm); padding: 0.75rem;">
                <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.825rem; font-weight: 600; cursor: pointer;">
                  <input type="checkbox" id="post-disable-ads" style="margin-top: 2px;" />
                  <span>Nonaktifkan Iklan pada artikel ini (Exclude Ads)</span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" id="btn-cancel-modal" class="btn btn-outline btn-sm">Batal</button>
          <button type="submit" id="btn-save-post" class="btn btn-primary btn-sm">Simpan Artikel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { getPosts, createPost, updatePost, deletePost } from "@core/content/posts";
    import { slugify } from "@core/utils/slug";
    import { formatDate } from "@core/utils/date";
    import { uploadImage } from "@core/utils/uploader";
    import { getSettings, triggerDeployHook, pingIndexNow } from "@core/settings/site";
    import { site } from "@config/site";
    import type { Post } from "@core/api/types";

    let allPosts: Post[] = [];

    const postsList = document.getElementById("posts-list");
    const searchInput = document.getElementById("search-posts") as HTMLInputElement;
    const filterStatus = document.getElementById("filter-status") as HTMLSelectElement;
    const filterCategory = document.getElementById("filter-category") as HTMLSelectElement;

    const modal = document.getElementById("post-modal");
    const modalTitle = document.getElementById("modal-title");
    const btnOpenModal = document.getElementById("btn-open-modal");
    const btnCloseModal = document.getElementById("btn-close-modal");
    const btnCancelModal = document.getElementById("btn-cancel-modal");
    const postForm = document.getElementById("post-form") as HTMLFormElement;
    const btnSavePost = document.getElementById("btn-save-post") as HTMLButtonElement;

    // Form inputs
    const postIdInput = document.getElementById("post-id") as HTMLInputElement;
    const postTitleInput = document.getElementById("post-title") as HTMLInputElement;
    const postSlugInput = document.getElementById("post-slug") as HTMLInputElement;
    const postCategoryInput = document.getElementById("post-category") as HTMLInputElement;
    const postStatusSelect = document.getElementById("post-status") as HTMLSelectElement;
    const postImageInput = document.getElementById("post-image") as HTMLInputElement;
    const postExcerptInput = document.getElementById("post-excerpt") as HTMLTextAreaElement;
    const postContentInput = document.getElementById("post-content") as HTMLTextAreaElement;
    const postTagsInput = document.getElementById("post-tags") as HTMLInputElement;
    const postDisableAds = document.getElementById("post-disable-ads") as HTMLInputElement;

    // Image Upload Elements
    const dropzone = document.getElementById("dropzone") as HTMLDivElement;
    const fileInput = document.getElementById("post-image-file") as HTMLInputElement;
    const btnBrowse = document.getElementById("btn-browse-file");
    const dropzoneEmpty = document.getElementById("dropzone-empty") as HTMLDivElement;
    const dropzonePreview = document.getElementById("dropzone-preview") as HTMLDivElement;
    const previewImg = document.getElementById("preview-img") as HTMLImageElement;
    const previewFilename = document.getElementById("preview-filename") as HTMLParagraphElement;
    const uploadSpinner = document.getElementById("upload-spinner") as HTMLDivElement;
    const btnChangeImg = document.getElementById("btn-change-img");
    const btnRemoveImg = document.getElementById("btn-remove-img");
    const btnToggleUrl = document.getElementById("btn-toggle-url");
    const urlManualWrap = document.getElementById("url-manual-wrap") as HTMLDivElement;
    const postImageManual = document.getElementById("post-image-manual") as HTMLInputElement;

    function setPreview(url: string, name: string = "Foto Artikel") {
      postImageInput.value = url;
      postImageManual.value = url;
      if (url) {
        previewImg.src = url;
        previewFilename.textContent = name;
        dropzoneEmpty.style.display = "none";
        dropzonePreview.style.display = "flex";
      } else {
        previewImg.src = "";
        dropzoneEmpty.style.display = "flex";
        dropzonePreview.style.display = "none";
      }
    }

    async function handleFileUpload(file: File) {
      if (!file || !file.type.startsWith("image/")) {
        (window as any).showToast("Pilih file gambar valid (JPG, PNG, WebP).", "error");
        return;
      }
      dropzoneEmpty.style.display = "none";
      dropzonePreview.style.display = "none";
      uploadSpinner.style.display = "block";

      try {
        const uploadedUrl = await uploadImage(file);
        setPreview(uploadedUrl, file.name);
        (window as any).showToast("Foto berhasil diunggah!", "success");
      } catch (err: any) {
        (window as any).showToast("Gagal upload: " + err.message, "error");
        dropzoneEmpty.style.display = "flex";
      } finally {
        uploadSpinner.style.display = "none";
      }
    }

    if (btnBrowse) btnBrowse.addEventListener("click", () => fileInput.click());
    if (btnChangeImg) btnChangeImg.addEventListener("click", () => fileInput.click());
    if (btnRemoveImg) btnRemoveImg.addEventListener("click", () => {
      fileInput.value = "";
      setPreview("");
    });

    fileInput.addEventListener("change", () => {
      if (fileInput.files && fileInput.files[0]) handleFileUpload(fileInput.files[0]);
    });

    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropzone.classList.add("dragover");
    });
    dropzone.addEventListener("dragleave", () => dropzone.classList.remove("dragover"));
    dropzone.addEventListener("drop", (e) => {
      e.preventDefault();
      dropzone.classList.remove("dragover");
      if (e.dataTransfer?.files?.[0]) handleFileUpload(e.dataTransfer.files[0]);
    });

    if (btnToggleUrl) {
      btnToggleUrl.addEventListener("click", () => {
        urlManualWrap.style.display = urlManualWrap.style.display === "none" ? "block" : "none";
      });
    }

    postImageManual.addEventListener("input", () => {
      setPreview(postImageManual.value.trim(), "URL Luar");
    });

    postTitleInput.addEventListener("input", () => {
      if (!postIdInput.value) {
        postSlugInput.value = slugify(postTitleInput.value);
      }
    });

    function openModal(post?: Post) {
      if (post) {
        if (modalTitle) modalTitle.textContent = "Edit Artikel";
        postIdInput.value = post.id;
        postTitleInput.value = post.title;
        postSlugInput.value = post.slug;
        postCategoryInput.value = post.category || "";
        postStatusSelect.value = post.status || "published";
        postExcerptInput.value = post.excerpt || "";
        postContentInput.value = post.content || "";
        postTagsInput.value = Array.isArray(post.tags) ? post.tags.join(", ") : (post.tags || "");
        postDisableAds.checked = !!post.disable_ads;
        setPreview(post.image || "", "Foto Artikel");
      } else {
        if (modalTitle) modalTitle.textContent = "Buat Artikel Baru";
        postForm.reset();
        postIdInput.value = "";
        postDisableAds.checked = false;
        setPreview("");
      }
      if (modal) modal.style.display = "flex";
    }

    function closeModal() {
      if (modal) modal.style.display = "none";
    }

    if (btnOpenModal) btnOpenModal.addEventListener("click", () => openModal());
    if (btnCloseModal) btnCloseModal.addEventListener("click", closeModal);
    if (btnCancelModal) btnCancelModal.addEventListener("click", closeModal);

    function renderFilteredPosts() {
      if (!postsList) return;
      const search = (searchInput?.value || "").toLowerCase().trim();
      const status = filterStatus?.value || "all";
      const category = filterCategory?.value || "all";

      const filtered = (allPosts || []).filter((p) => {
        if (!p) return false;
        const title = (p.title || "").toLowerCase();
        const slug = (p.slug || "").toLowerCase();
        const matchesSearch = !search || title.includes(search) || slug.includes(search);
        const matchesStatus = status === "all" || p.status === status;
        const matchesCat = category === "all" || (p.category && p.category.toLowerCase() === category.toLowerCase());
        return matchesSearch && matchesStatus && matchesCat;
      });

      if (filtered.length === 0) {
        postsList.innerHTML = `
          <tr>
            <td colspan="6" style="text-align: center; color: var(--admin-text-muted); padding: 3rem;">
              <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔍</div>
              <p style="font-weight: 600;">Tidak ada artikel yang sesuai filter.</p>
            </td>
          </tr>
        `;
        return;
      }

      postsList.innerHTML = filtered.map((post) => `
        <tr>
          <td>
            <div style="display: flex; align-items: center; gap: 0.75rem;">
              ${post.image ? `<img src="${post.image}" alt="" style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid var(--admin-border); flex-shrink: 0;" />` : `
                <div style="width: 44px; height: 44px; background: var(--admin-surface-alt); border-radius: 6px; border: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">📰</div>
              `}
              <div>
                <div style="font-weight: 600; color: var(--admin-text-main); font-size: 0.9rem;">${post.title}</div>
                <div style="font-size: 0.75rem; color: var(--admin-text-muted);">/blog/${post.slug}</div>
              </div>
            </div>
          </td>
          <td><span class="category-tag">${post.category || "Umum"}</span></td>
          <td>
            <span class="status-pill ${post.status === 'published' ? 'published' : 'draft'}">
              ${post.status === 'published' ? '● Published' : '○ Draft'}
            </span>
          </td>
          <td>
            <span style="font-size: 0.75rem; color: ${post.disable_ads ? 'var(--admin-danger)' : 'var(--admin-success)'}; font-weight: 700;">
              ${post.disable_ads ? "🚫 Off" : "✅ Aktif"}
            </span>
          </td>
          <td style="font-size: 0.825rem; color: var(--admin-text-muted);">${formatDate(post.published_at || post.updated_at)}</td>
          <td style="text-align: right;">
            <div class="action-buttons">
              <button class="btn-icon-action btn-edit" data-id="${post.id}">✏️ Edit</button>
              <button class="btn-icon-action delete btn-delete" data-id="${post.id}">🗑️</button>
            </div>
          </td>
        </tr>
      `).join("");

      document.querySelectorAll(".btn-edit").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = (btn as HTMLElement).dataset.id;
          const post = allPosts.find((p) => p.id === id);
          if (post) openModal(post);
        });
      });

      document.querySelectorAll(".btn-delete").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = (btn as HTMLElement).dataset.id;
          if (confirm("Apakah Anda yakin ingin menghapus artikel ini?")) {
            if (id) {
              await deletePost(id);
              (window as any).showToast("Artikel berhasil dihapus!", "success");
              loadPosts();
            }
          }
        });
      });
    }

    async function loadPosts() {
      try {
        allPosts = await getPosts();
        
        // Populate category filter dropdown
        const categories = Array.from(new Set(allPosts.map((p) => p.category).filter(Boolean)));
        if (filterCategory) {
          filterCategory.innerHTML = `<option value="all">Semua Kategori</option>` + categories.map((c) => `<option value="${c}">${c}</option>`).join("");
        }

        renderFilteredPosts();
      } catch (err) {
        console.error(err);
      }
    }

    searchInput.addEventListener("input", renderFilteredPosts);
    filterStatus.addEventListener("change", renderFilteredPosts);
    filterCategory.addEventListener("change", renderFilteredPosts);

    postForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      btnSavePost.disabled = true;
      btnSavePost.textContent = "Menyimpan...";

      const isEdit = !!postIdInput.value;
      const tagsArray = postTagsInput.value.split(",").map((t) => t.trim()).filter(Boolean);

      const postData: Partial<Post> = {
        title: postTitleInput.value.trim(),
        slug: postSlugInput.value.trim() || slugify(postTitleInput.value),
        category: postCategoryInput.value.trim(),
        status: postStatusSelect.value as "published" | "draft",
        image: postImageInput.value.trim(),
        excerpt: postExcerptInput.value.trim(),
        content: postContentInput.value,
        tags: tagsArray,
        disable_ads: postDisableAds.checked,
        updated_at: new Date().toISOString(),
      };

      try {
        if (isEdit) {
          await updatePost(postIdInput.value, postData);
          (window as any).showToast("Artikel berhasil diperbarui!", "success");
        } else {
          postData.published_at = new Date().toISOString();
          await createPost(postData);
          (window as any).showToast("Artikel baru berhasil dibuat!", "success");
        }

        if (postData.status === "published") {
          try {
            const settings = await getSettings();
            if (settings.deploy_hook_url) triggerDeployHook(settings.deploy_hook_url);
            if (settings.indexnow_key) {
              const fullUrl = `${site.url}/blog/${postData.slug}`;
              pingIndexNow(new URL(site.url).host, settings.indexnow_key, [fullUrl]);
            }
          } catch (hookErr) {
            console.warn("Deploy hook error:", hookErr);
          }
        }

        closeModal();
        loadPosts();
      } catch (err: any) {
        (window as any).showToast("Gagal menyimpan artikel: " + (err.message || "Error"), "error");
      } finally {
        btnSavePost.disabled = false;
        btnSavePost.textContent = "Simpan Artikel";
      }
    });

    loadPosts();
  </script>
</AdminLayout>
