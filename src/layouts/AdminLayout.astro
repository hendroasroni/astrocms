---
import "@styles/admin.css";
import { site } from "@config/site";

export interface Props {
  title?: string;
  activeMenu?: "dashboard" | "posts" | "pages" | "products" | "settings";
}

const { title = "Admin Panel", activeMenu = "dashboard" } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {site.name} Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <!-- Anti-FOUC Loading Screen -->
    <div id="auth-skeleton" class="skeleton-screen">
      <div class="spinner"></div>
      <p style="color: #64748b; font-size: 0.875rem; font-weight: 500;">Memeriksa sesi login admin...</p>
    </div>

    <!-- Admin App Wrapper (Initially hidden) -->
    <div id="admin-app" class="admin-layout" style="display: none;">
      <!-- Sidebar -->
      <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
          <img src="/favicon.svg" alt={site.name} width="26" height="26" />
          <span class="brand-title">{site.name}</span>
          <span class="brand-tag">CMS</span>
        </div>

        <nav class="admin-nav">
          <div class="admin-nav-section-title">Menu Utama</div>
          <a href="/admin" class={`admin-nav-item ${activeMenu === "dashboard" ? "active" : ""}`}>
            <span class="nav-icon">📊</span>
            <span>Dashboard</span>
          </a>
          <a href="/admin/posts" class={`admin-nav-item ${activeMenu === "posts" ? "active" : ""}`}>
            <span class="nav-icon">📝</span>
            <span>Kelola Artikel</span>
          </a>
          <a href="/admin/pages" class={`admin-nav-item ${activeMenu === "pages" ? "active" : ""}`}>
            <span class="nav-icon">📄</span>
            <span>Kelola Halaman</span>
          </a>
          <a href="/admin/products" class={`admin-nav-item ${activeMenu === "products" ? "active" : ""}`}>
            <span class="nav-icon">🛍️</span>
            <span>Katalog Produk</span>
          </a>

          <div class="admin-nav-section-title" style="margin-top: 0.5rem;">Konfigurasi</div>
          <a href="/admin/settings" class={`admin-nav-item ${activeMenu === "settings" ? "active" : ""}`}>
            <span class="nav-icon">⚙️</span>
            <span>Pengaturan Situs</span>
          </a>
        </nav>

        <div class="admin-nav-footer">
          <a href="/" target="_blank" class="admin-nav-item">
            <span class="nav-icon">🌐</span>
            <span>Buka Website ↗</span>
          </a>
          <button id="btn-logout" class="admin-nav-item" style="width: 100%; border: none; background: transparent; text-align: left; cursor: pointer; color: #f87171;">
            <span class="nav-icon">🚪</span>
            <span>Keluar (Logout)</span>
          </button>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="admin-main">
        <header class="admin-topbar">
          <div class="admin-topbar-left">
            <h1 class="admin-page-title">{title}</h1>
          </div>

          <div class="admin-topbar-right">
            <a href="/" target="_blank" class="btn btn-outline btn-sm" style="display: inline-flex; align-items: center; gap: 0.35rem;">
              <span>🌐</span>
              <span>Lihat Web</span>
            </a>

            <div class="user-pill">
              <div class="user-avatar" id="user-avatar">A</div>
              <span id="user-display">Admin</span>
            </div>
          </div>
        </header>

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast-container" class="toast-container"></div>

    <script>
      import { subscribeAuth, logout } from "@core/auth/auth";

      const skeleton = document.getElementById("auth-skeleton");
      const app = document.getElementById("admin-app");
      const userDisplay = document.getElementById("user-display");
      const userAvatar = document.getElementById("user-avatar");
      const btnLogout = document.getElementById("btn-logout");

      // Global Toast Notification Helper
      (window as any).showToast = (message: string, type: "success" | "error" | "info" = "info") => {
        const container = document.getElementById("toast-container");
        if (!container) return;

        const toast = document.createElement("div");
        toast.className = `toast ${type}`;
        toast.innerHTML = `
          <span>${type === "success" ? "✅" : type === "error" ? "❌" : "ℹ️"}</span>
          <span>${message}</span>
        `;
        container.appendChild(toast);

        setTimeout(() => {
          toast.style.opacity = "0";
          toast.style.transition = "opacity 0.3s ease";
          setTimeout(() => toast.remove(), 300);
        }, 3500);
      };

      subscribeAuth((user) => {
        if (!user) {
          window.location.href = "/login";
        } else {
          const email = user.email || "Admin";
          if (userDisplay) userDisplay.textContent = email;
          if (userAvatar) userAvatar.textContent = email.charAt(0).toUpperCase();
          if (skeleton) skeleton.style.display = "none";
          if (app) app.style.display = "flex";
        }
      });

      if (btnLogout) {
        btnLogout.addEventListener("click", async () => {
          if (confirm("Apakah Anda yakin ingin logout dari dashboard?")) {
            await logout();
            window.location.href = "/login";
          }
        });
      }
    </script>
  </body>
</html>
